   descricao: z.string().min(1).optional(),
diff --git a/src/routes/__tests__/ronda-foto-upload.test.ts b/src/routes/__tests__/ronda-foto-upload.test.ts
new file mode 100644
index 0000000..a8de7a5
--- /dev/null
+++ b/src/routes/__tests__/ronda-foto-upload.test.ts
@@ -0,0 +1,143 @@
+/**
+ * Camada 2 do ADR-021 (decisão de campo, 16/08/2026): a foto sobe sozinha,
+ * em multipart, no momento em que é tirada.
+ *
+ * Estes testes rodam contra o `app` inteiro, e não contra o router isolado,
+ * pelo mesmo motivo de `ronda-body-limit.test.ts`: o que está em jogo é a
+ * convivência da rota nova com os middlewares globais. Em particular, o
+ * `rondaJsonParser` de 25mb é montado em `app.ts` no prefixo
+ * `/api/convergia/ronda` — se ele tentasse ler um corpo multipart, a rota de
+ * upload morreria antes de existir, e o sintoma seria idêntico ao 413 de
+ * produção de 15/08.
+ *
+ * Sem `GUARDIAN_BASE_URL` no ambiente de teste, a persistência falha depois
+ * da rota (e vira 400, pelo tratador genérico). Por isso aqui só se afirma o
+ * que é afirmável sem Guardian — que a requisição atravessou parser e
+ * roteamento. O comportamento de negócio (base64 ida e volta, original
+ * opcional, 404 por versão ausente) é coberto em `foto-store.test.ts`, que
+ * injeta um Guardian falso.
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { Server } from "node:http";
+import app from "../../app";
+import { RONDA_FOTO_MAX_BYTES, SUPPORTED_RONDA_FOTO_MIME_TYPES } from "../../convergia/ronda/foto-store";
+import { validateRondaSubmission } from "../../convergia/ronda/validation";
+
+async function withServer<T>(run: (baseUrl: string) => Promise<T>): Promise<T> {
+  const server: Server = await new Promise((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  try {
+    const { port } = server.address() as { port: number };
+    return await run(`http://127.0.0.1:${port}`);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+}
+
+function jpegOfKB(kb: number): Blob {
+  return new Blob([Buffer.alloc(Math.round(kb * 1024), 7)], { type: "image/jpeg" });
+}
+
+function postFoto(baseUrl: string, form: FormData) {
+  return fetch(`${baseUrl}/api/convergia/ronda/foto`, { method: "POST", body: form });
+}
+
+async function errorOf(response: Response): Promise<string> {
+  const body = (await response.json()) as { error?: string };
+  return String(body.error ?? "");
+}
+
+/**
+ * O ponto central: um corpo multipart de 6 MB chega inteiro na rota — é
+ * exatamente o tamanho de original que não cabe no payload de 25mb do
+ * relatório e que motivou esta rota existir.
+ */
+test("POST /api/convergia/ronda/foto aceita multipart com campo e original de 6 MB", async () => {
+  await withServer(async (baseUrl) => {
+    const form = new FormData();
+    form.set("campo", jpegOfKB(200), "campo.jpg");
+    form.set("original", jpegOfKB(6 * 1024), "original.jpg");
+    form.set("achadoId", "achado-1");
+
+    const response = await postFoto(baseUrl, form);
+    assert.notEqual(response.status, 413, "original de 6 MB não pode ser rejeitada por limite de corpo");
+    assert.notEqual(response.status, 404, "a rota de upload de foto precisa existir");
+    // Sem Guardian o erro é de persistência, não de requisição malformada.
+    assert.doesNotMatch(await errorOf(response), /obrigatória/i, "o multipart precisa ter sido lido — `campo` chegou");
+  });
+});
+
+test("POST /api/convergia/ronda/foto recusa upload sem a versão de campo", async () => {
+  await withServer(async (baseUrl) => {
+    const form = new FormData();
+    form.set("original", jpegOfKB(100), "original.jpg");
+    const response = await postFoto(baseUrl, form);
+    assert.equal(response.status, 400);
+    assert.match(await errorOf(response), /obrigatória/i);
+  });
+});
+
+/** A original é opcional de propósito: em rede ruim o cliente sobe só a versão de campo, e o relatório não perde nada. */
+test("POST /api/convergia/ronda/foto aceita só a versão de campo", async () => {
+  await withServer(async (baseUrl) => {
+    const form = new FormData();
+    form.set("campo", jpegOfKB(200), "campo.jpg");
+    const response = await postFoto(baseUrl, form);
+    assert.notEqual(response.status, 413);
+    assert.doesNotMatch(await errorOf(response), /obrigatória/i);
+  });
+});
+
