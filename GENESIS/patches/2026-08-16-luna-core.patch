@@ -0,0 +1,150 @@
+// Camada 2 do ADR-021 (decisão de campo, 16/08/2026): a foto de um achado
+// sobe sozinha, no momento em que é tirada, em vez de viajar embutida no
+// relatório no fim da ronda.
+//
+// O que forçou a mudança, medido em campo:
+//
+//  - Espaço no aparelho. A original de uma foto de 12MP ocupa ~9,3 MB em
+//    base64 contra 0,13 MB da versão comprimida que o relatório usa. Guardar
+//    as duas até o fim da ronda enchia o armazenamento do navegador e é a
+//    explicação mais provável para o Chrome descartar a aba no meio da
+//    coleta.
+//  - Teto de payload. `POST /convergia/ronda` aceita 25 MB
+//    (`RONDA_JSON_BODY_LIMIT`) — uma única original em base64 come um terço
+//    disso, e três ou quatro travariam a ronda inteira. Pelo relatório a
+//    original simplesmente não cabe.
+//  - Risco concentrado. Um envio único no fim significa que qualquer falha
+//    põe a ronda inteira em risco; foto que já subiu está a salvo mesmo se o
+//    aparelho morrer em seguida.
+//
+// Multipart, não JSON/base64: base64 infla 33% no fio, que é exatamente o
+// custo que torna a original inviável. `POST /convergia/ronda/foto` recebe
+// binário; base64 fica só na persistência, mesmo padrão de
+// `visual-template-store.ts` (coleção genérica do `GuardianContract`,
+// nenhuma tabela nova, nenhum mecanismo de storage novo).
+import { randomUUID } from "node:crypto";
+import type { GuardianContract } from "../../luna/guardian-contract";
+import { HttpGuardianClient } from "../../luna/adapters/guardian-http-adapter";
+
+const COLLECTION = "convergia_ronda_fotos";
+const ORIGIN = "convergia-ronda-foto-routes";
+
+/** Prefixo do id de foto — deixa `fotoIds[]` legível em log e distinguível de id de achado ou de ronda a olho nu. */
+export const RONDA_FOTO_ID_PREFIX = "rfoto_";
+
+export const SUPPORTED_RONDA_FOTO_MIME_TYPES = new Set(["image/jpeg", "image/png", "image/webp"]);
+
+/**
+ * Teto por arquivo no upload de foto. Dimensionado para a original crua de
+ * um celular atual (12–50MP, 3–12 MB de JPEG) com folga, e deliberadamente
+ * separado do teto do relatório: são requisições de natureza diferente e
+ * misturar os dois limites foi o que produziu o 413 de 15/08 em produção.
+ */
+export const RONDA_FOTO_MAX_BYTES = 30 * 1024 * 1024;
+
+/** Qual versão da foto está sendo pedida. "campo" é a comprimida (1280px/JPEG q0.7) que o relatório usa; "original" é o arquivo como saiu da câmera. */
+export type RondaFotoVersao = "campo" | "original";
+
+interface RondaFotoRow {
+  id?: string | number;
+  foto_id: string;
+  /** Achado a que a foto pertence, quando o cliente informa. Opcional de propósito: a foto sobe *antes* de a ronda existir no servidor, então este campo é rastreabilidade, não chave estrangeira. */
+  achado_id?: string;
+  campo_mime_type: string;
+  /** Base64 sem prefixo `data:`, mesmo padrão de `convergia_visual_templates.image_data_base64`. */
+  campo_data_base64: string;
+  campo_size_bytes: number;
+  original_mime_type?: string;
+  original_data_base64?: string;
+  original_size_bytes?: number;
+  created_at: string;
+}
+
+export interface RondaFotoSummary {
+  fotoId: string;
+  mimeType: string;
+  sizeBytes: number;
+  /** A original é opcional: sem rede boa, o cliente pode subir só a versão de campo e o relatório não perde nada. */
+  temOriginal: boolean;
+  originalSizeBytes?: number;
+  createdAt: string;
+}
+
+export class RondaFotoValidationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "RondaFotoValidationError";
+  }
+}
+
+export class RondaFotoStore {
+  constructor(private readonly guardian: GuardianContract = new HttpGuardianClient()) {}
+
+  async create(
+    campo: { buffer: Buffer; mimeType: string },
+    original?: { buffer: Buffer; mimeType: string },
+    achadoId?: string,
+  ): Promise<RondaFotoSummary> {
+    if (!SUPPORTED_RONDA_FOTO_MIME_TYPES.has(campo.mimeType)) {
+      throw new RondaFotoValidationError(`Tipo de imagem "${campo.mimeType}" não suportado. Use JPEG, PNG ou WebP.`);
+    }
+    if (original && !SUPPORTED_RONDA_FOTO_MIME_TYPES.has(original.mimeType)) {
+      throw new RondaFotoValidationError(`Tipo de imagem "${original.mimeType}" não suportado na foto original. Use JPEG, PNG ou WebP.`);
+    }
+
+    const fotoId = `${RONDA_FOTO_ID_PREFIX}${randomUUID()}`;
+    const createdAt = new Date().toISOString();
+
+    await this.guardian.save(
+      {
+        collection: COLLECTION,
+        data: {
+          foto_id: fotoId,
+          ...(achadoId ? { achado_id: achadoId } : {}),
+          campo_mime_type: campo.mimeType,
+          campo_data_base64: campo.buffer.toString("base64"),
+          campo_size_bytes: campo.buffer.byteLength,
+          ...(original
+            ? {
+                original_mime_type: original.mimeType,
+                original_data_base64: original.buffer.toString("base64"),
+                original_size_bytes: original.buffer.byteLength,
+              }
+            : {}),
+          created_at: createdAt,
+        },
+      },
+      ORIGIN,
+    );
+
+    return {
+      fotoId,
+      mimeType: campo.mimeType,
+      sizeBytes: campo.buffer.byteLength,
+      temOriginal: Boolean(original),
+      originalSizeBytes: original?.buffer.byteLength,
+      createdAt,
+    };
+  }
+
+  private async findRow(fotoId: string): Promise<RondaFotoRow | undefined> {
+    const rows = (await this.guardian.search({ collection: COLLECTION, filter: { foto_id: fotoId }, limit: 1 }, ORIGIN)) as unknown as RondaFotoRow[];
+    return rows[0];
+  }
+
+  /**
+   * Bytes de uma versão da foto. Pedir `original` numa foto que subiu só com
+   * a versão de campo devolve `undefined` em vez de cair para a comprimida:
+   * quem pede a original quer resolução cheia, e receber silenciosamente
+   * 1280px no lugar seria pior do que receber um 404 explícito.
+   */
+  async getVersion(fotoId: string, versao: RondaFotoVersao): Promise<{ data: Buffer; mimeType: string } | undefined> {
+    const row = await this.findRow(fotoId);
+    if (!row) return undefined;
+    if (versao === "original") {
+      if (!row.original_data_base64 || !row.original_mime_type) return undefined;
+      return { data: Buffer.from(row.original_data_base64, "base64"), mimeType: row.original_mime_type };
+    }
+    return { data: Buffer.from(row.campo_data_base64, "base64"), mimeType: row.campo_mime_type };
+  }
+}
