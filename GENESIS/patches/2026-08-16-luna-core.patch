+++ b/src/convergia/ronda/__tests__/foto-store.test.ts
@@ -0,0 +1,96 @@
+/**
+ * Camada 2 do ADR-021 — armazenamento da foto que sobe sozinha durante a
+ * ronda. Guardian falso, como em `flag-store.test.ts`: o que se verifica
+ * aqui é o comportamento do store, não a persistência real.
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { GuardianContract, StorageRecord } from "../../../luna/guardian-contract";
+import { RondaFotoStore, RondaFotoValidationError, RONDA_FOTO_ID_PREFIX } from "../foto-store";
+
+class FakeGuardian implements GuardianContract {
+  readonly rows: StorageRecord[] = [];
+
+  async save(input: { collection: string; data: Record<string, unknown> }): Promise<StorageRecord | null> {
+    const row = { id: this.rows.length + 1, ...input.data } as StorageRecord;
+    this.rows.push(row);
+    return row;
+  }
+  async update(): Promise<StorageRecord | null> {
+    throw new Error("not used by RondaFotoStore");
+  }
+  async delete(): Promise<boolean> {
+    throw new Error("not used by RondaFotoStore");
+  }
+  async get(): Promise<StorageRecord | null> {
+    throw new Error("not used by RondaFotoStore");
+  }
+  async search(input: { collection: string; filter?: Record<string, unknown> }): Promise<StorageRecord[]> {
+    if (input.collection !== "convergia_ronda_fotos") return [];
+    if (!input.filter) return this.rows;
+    return this.rows.filter((row) => (row as Record<string, unknown>).foto_id === input.filter?.foto_id);
+  }
+}
+
+const campo = () => ({ buffer: Buffer.from([0xff, 0xd8, 0xff, 0x01, 0x02]), mimeType: "image/jpeg" });
+const original = () => ({ buffer: Buffer.alloc(64, 9), mimeType: "image/jpeg" });
+
+test("create devolve um id prefixado e guarda o tamanho real, sem o inchaço do base64", async () => {
+  const guardian = new FakeGuardian();
+  const foto = await new RondaFotoStore(guardian).create(campo(), original(), "achado-1");
+
+  assert.ok(foto.fotoId.startsWith(RONDA_FOTO_ID_PREFIX));
+  assert.equal(foto.temOriginal, true);
+  // `sizeBytes` é o binário, não a string base64 — é o número que serve pra
+  // raciocinar sobre espaço e banda de verdade.
+  assert.equal(foto.sizeBytes, 5);
+  assert.equal(foto.originalSizeBytes, 64);
+  assert.equal((guardian.rows[0] as Record<string, unknown>).achado_id, "achado-1");
+});
+
+test("os bytes voltam idênticos ao que subiu, nas duas versões", async () => {
+  const guardian = new FakeGuardian();
+  const store = new RondaFotoStore(guardian);
+  const foto = await store.create(campo(), original());
+
+  const daCampo = await store.getVersion(foto.fotoId, "campo");
+  const daOriginal = await store.getVersion(foto.fotoId, "original");
+  assert.deepEqual(daCampo?.data, campo().buffer);
+  assert.deepEqual(daOriginal?.data, original().buffer);
+  assert.equal(daCampo?.mimeType, "image/jpeg");
+});
+
+/**
+ * A original é opcional (rede ruim: sobe só a versão de campo). Pedir a
+ * original nesse caso devolve `undefined` em vez de cair para a comprimida —
+ * quem pede original quer resolução cheia, e receber 1280px sem aviso seria
+ * pior do que receber um 404 explícito.
+ */
+test("sem original, pedir a original devolve undefined em vez de cair para a comprimida", async () => {
+  const store = new RondaFotoStore(new FakeGuardian());
+  const foto = await store.create(campo());
+
+  assert.equal(foto.temOriginal, false);
+  assert.equal(foto.originalSizeBytes, undefined);
+  assert.ok(await store.getVersion(foto.fotoId, "campo"));
+  assert.equal(await store.getVersion(foto.fotoId, "original"), undefined);
+});
+
+test("foto inexistente devolve undefined nas duas versões", async () => {
+  const store = new RondaFotoStore(new FakeGuardian());
+  assert.equal(await store.getVersion("rfoto_nao_existe", "campo"), undefined);
+  assert.equal(await store.getVersion("rfoto_nao_existe", "original"), undefined);
+});
+
+test("recusa mime type não suportado, na versão de campo e na original", async () => {
+  const store = new RondaFotoStore(new FakeGuardian());
+  await assert.rejects(() => store.create({ buffer: Buffer.alloc(4), mimeType: "application/pdf" }), RondaFotoValidationError);
+  await assert.rejects(() => store.create(campo(), { buffer: Buffer.alloc(4), mimeType: "image/gif" }), RondaFotoValidationError);
+});
+
+test("cada upload gera um id próprio — dois cliques na mesma foto não colidem", async () => {
+  const store = new RondaFotoStore(new FakeGuardian());
+  const a = await store.create(campo());
+  const b = await store.create(campo());
+  assert.notEqual(a.fotoId, b.fotoId);
+});
